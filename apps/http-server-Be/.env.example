PORT=3004
EXPRESS_SESSION_SECRET=
ORIGIN=
CORS_ORIGIN=
NODE_ENV=


# MONGODB_URI=
MONGODB_LOCAL_URI=
ACCESS_TOKEN_EXPIRY=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=
REFRESH_TOKEN_SECRET=

CLOUDNARY_APISECRET=
CLOUDNARY_APIKEY=
CLOUDNARY_CLOUDNAME=

# Mediasoup configuration
# Set to your machine's LAN IP when testing group calls from other devices
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# Resend — account email verification
# Get from https://resend.com/api-keys. The RESEND_FROM_EMAIL domain must be
# verified in the Resend dashboard or every send is rejected.
RESEND_API=
RESEND_FROM_EMAIL=Threadly <noreply@barmanji.com>





# ── Sentry ────────────────────────────────────────────────────────────────────
# DSN from the Sentry project settings. Leave EMPTY to disable the SDK
# completely — `instrument.ts` passes `enabled: Boolean(dsn)`, so no DSN means
# the whole integration is inert and nothing is sent anywhere.
SENTRY_DSN=

# Sent on every event. Without it, Sentry groups errors from the previous deploy
# together with the new one and stack traces have no source maps to resolve
# against. Set by the release tooling (`pnpm sentry-release`); see below.
SENTRY_RELEASE=

# Fraction of backend transactions to keep. Endpoints that need more or less
# are special-cased in `instrument.ts` (healthcheck 0, whiteboard 1).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Sentry source map upload (build-time only, never shipped) ─────────────────
# Needed by `pnpm sentry-release` and `pnpm sentry-sourcemaps`. The auth token
# is an ORGANIZATION auth token from Sentry → Settings → Auth Tokens, and it
# must NOT have the `project:releases` scope restricted away — the release and
# the artifacts have to be created before the server boots.
#
# These are deliberately NOT prefixed with `VITE_`: a prefixed var gets inlined
# into the browser bundle at build time, which would publish the token to every
# visitor. Nothing reads them at runtime, only the CLI.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

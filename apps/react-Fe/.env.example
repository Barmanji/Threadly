VITE_SOCKET_URI=http://localhost:3004
VITE_SERVER_URI=http://localhost:3004/api/v1
VITE_MEDIASOUP_URL=http://localhost:3004


# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave EMPTY to disable the SDK — `src/sentry/config.ts` sets
# `enabled: Boolean(dsn)`, so no DSN means nothing loads and nothing is sent.
VITE_SENTRY_DSN=

# Normally left empty. The `@sentry/vite-plugin` sets the release at build time
# from your git state; setting this by hand overrides that, and mismatching it is
# the usual cause of "minified React errors" showing no source.
VITE_SENTRY_RELEASE=

# Performance monitoring. 0 disables it. Leave these out to get sensible
# defaults (1.0 in dev, 0.2 / 0.1 in production).
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_PROFILES_SAMPLE_RATE=

# Session Replay. On-error replay is on by default at 1.0.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=

# Replay privacy. Both default to TRUE, which is the correct default for a chat
# app: every message body and input is replaced with a block. Setting either to
# the string `false` is the only way to un-mask, and should be a deliberate,
# temporary decision — not something set once in a deploy script.
VITE_SENTRY_REPLAY_MASK_ALL_TEXT=
VITE_SENTRY_REPLAY_BLOCK_ALL_MEDIA=
